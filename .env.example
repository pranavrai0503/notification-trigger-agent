# Application
NODE_ENV=development
PORT=3000

# BrowserStack Credentials
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key
BROWSERSTACK_API_URL=https://api-cloud.browserstack.com

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_agent
DB_USER=postgres
DB_PASSWORD=your_db_password

# Notification API
NOTIFICATION_API_BASE_URL=https://api.example.com
NOTIFICATION_API_KEY=your_api_key

# App Configuration
APP_PACKAGE_ANDROID=com.example.app
APP_PACKAGE_IOS=com.example.app
APP_ACTIVITY_ANDROID=com.example.app.MainActivity

# Test Configuration
DEFAULT_TIMEOUT_MS=30000
SESSION_TIMEOUT_MS=300000
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000

# WebSocket
WS_PORT=3001

# Logging
LOG_LEVEL=info
